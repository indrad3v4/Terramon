# ── Python ──
__pycache__/
*.pyc
*.pyo
*.egg-info/
*.egg
dist/
build/
*.whl
.venv/
venv/

# ── Node / Reflex ──
node_modules/
.web/
frontend.zip
reflex.lock/

# ── Data persistence (local — Railway uses volume mounts) ──
data/*.jsonl
# boot marker must NOT be baked into the image: a wiped volume would then
# still "see" it and report a false data_persisted (seed_count 19→0 with
# data_persisted=true, prod 2026-08-10)
data/boot_epoch.json
!data/.gitkeep

# ── IDE ──
.vscode/
.idea/
*.swp
*.swo
*~

# ── OS ──
.DS_Store
Thumbs.db

# ── Secrets ──
.env
.env.local

# ── Git ──
.git/
.gitignore
