# =============================================================================
# Terramon TMA — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Railway users: set these in the Railway Dashboard under Variables instead.
# =============================================================================

# ── HuggingFace Inference API ──────────────────────────────────────────
# Required for Scout standalone agent (main.py). Get a free token at:
#   https://huggingface.co/settings/tokens
# Free tier: 30K requests/month on Qwen/Qwen2.5-7B-Instruct and similar.
HF_TOKEN=hf_replace_with_your_token

# ── OpenRouter API Key ─────────────────────────────────────────────────
# Required for LLM-powered creature behavior (greetings, dialogue) in the
# Terramon TMA app. Get a key at:
#   https://openrouter.ai/keys
# Falls back to template-based responses when not set.
OPENROUTER_API_KEY=sk-or-v1-replace_with_your_key

# ── FAL.ai API Key (optional) ──────────────────────────────────────────
# Used for AI-generated creature portraits on summon. Get a key at:
#   https://fal.ai/dashboard
# Portrait generation runs in a background thread and silently skips if
# this key is missing.
FAL_KEY=fal-replace_with_your_key

# ── Stripe (optional) ──────────────────────────────────────────────────
# Used for payment gating on rare/legendary summons. Only needed when
# the StripePayment adapter is wired in.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
